{
  "name": "edds-wallet",
  "private": true,
  "version": "0.0.0",
  "description": "Edd's Wallet - a local-first virtual allowance app for a parent to run a child's ledger and teach basic money concepts.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev -w @edds-wallet/web\" \"npm:dev -w @edds-wallet/api\"",
    "build": "npm run build --workspace @edds-wallet/web",
    "start": "npm run build && npm run start --workspace @edds-wallet/api",
    "test": "npm run test --workspace @edds-wallet/api",
    "test:e2e": "npm run test:e2e --workspace @edds-wallet/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
